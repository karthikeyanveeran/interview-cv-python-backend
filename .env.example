# Interview.CV Python Backend Environment Configuration
# Copy this file to .env and update with your actual values

# Database (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/interview_cv

# Authentication (Required)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# AI Services (Required)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Agora Conversational AI (Required)
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CUSTOMER_ID=your_customer_id_here
AGORA_CUSTOMER_SECRET=your_customer_secret_here
AGORA_CONVERSATIONAL_AI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2

# Custom LLM Configuration
CUSTOM_LLM_URL=http://localhost:8000/api/audio-output
CUSTOM_LLM_API_KEY=internal

# Azure Speech Services (Optional)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage (Optional)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=interview-cv-uploads
R2_PUBLIC_URL=https://your-r2-domain.com

# Payment Gateways (Optional)
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Stripe (International)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key_here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
PYTHON_API_URL=http://localhost:8000
